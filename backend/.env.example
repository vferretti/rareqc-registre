# Configuration du backend (variables d'environnement).
# En dev, toutes ont des défauts raisonnables — `go run ./cmd/api/` fonctionne
# sans .env si la plateforme rareqc-infra tourne. Hors dev, fournir des vraies
# valeurs (les secrets de dev sont publics dans les repos).

# --- Serveur HTTP ---
# GIN_MODE=release active le mode production : le serveur REFUSE de démarrer
# si POSTGRES_PASSWORD/POSTGRES_SSLMODE/CORS_ALLOWED_ORIGINS ou un secret
# d'auth est resté à sa valeur de dev, si COOKIE_SECURE n'est pas true, si
# SESSION_SECRET fait moins de 32 caractères ou si une URL n'est pas https://.
# Logs JSON en release, texte en dev ; Swagger UI servi hors release seulement.
#GIN_MODE=release
PORT=8080
# Origines autorisées par CORS (séparées par des virgules). "*" interdit en release.
CORS_ALLOWED_ORIGINS=*
# Proxys (IP ou CIDR, séparés par des virgules) autorisés à poser les en-têtes
# X-Forwarded-For / X-Forwarded-Proto — ex. le réseau Docker du nginx frontal.
# Vide = aucun proxy de confiance : l'IP cliente journalisée est le pair TCP.
#TRUSTED_PROXIES=172.16.0.0/12

# --- PostgreSQL (plateforme rareqc-infra : port hôte 5440) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_USER=rareqc
POSTGRES_PASSWORD=rareqc
POSTGRES_DB=rareqc_registre
# disable (dev) | require | verify-full — obligatoire en release
POSTGRES_SSLMODE=disable

# --- Auth BFF (Keycloak, realm rareqc) — noms alignés sur radiant-portal ---
KEYCLOAK_HOST=http://localhost:8081
# URL interne si l'API tourne en conteneur (sinon = KEYCLOAK_HOST)
#KEYCLOAK_INTERNAL_HOST=http://keycloak:8080
KEYCLOAK_REALM=rareqc
KEYCLOAK_CLIENT=registre-admin-bff
KEYCLOAK_CLIENT_SECRET=dev-only-registre-admin-secret
# Signe les cookies de session httpOnly — générer une valeur forte hors dev
# (32 caractères minimum exigés en release : `openssl rand -base64 48`)
SESSION_SECRET=dev-only-session-secret-change-me
# Origine publique du portail admin : redirect de secours du flux OIDC et
# origine acceptée par la garde CSRF pour les requêtes POST/PUT/DELETE.
# https:// exigé en release (idem KEYCLOAK_HOST et PARTICIPANT_PORTAL_HOSTS).
PORTAL_HOST=http://localhost:5173
# Client OIDC du portail participant (A6) — sélectionné quand la requête
# provient d'une des origines listées dans PARTICIPANT_PORTAL_HOSTS
KEYCLOAK_PARTICIPANT_CLIENT=portail-participant-bff
KEYCLOAK_PARTICIPANT_CLIENT_SECRET=dev-only-portail-participant-secret
# Origines servies par le portail participant (séparées par des virgules) —
# doivent correspondre aux redirect URIs du client dans le realm
PARTICIPANT_PORTAL_HOSTS=http://localhost:5174,http://localhost:3002
# Flag Secure des cookies de session — true EXIGÉ en release (le serveur
# refuse de démarrer sinon : les cookies transportent les jetons Keycloak)
COOKIE_SECURE=false

# --- Documents ---
# database (défaut — aussi en production tant que l'upload S3 n'est pas
# implémenté) ou s3 (redirection au téléchargement seulement)
#STORAGE_TYPE=database

# --- Seed (scripts/seed, profil docker `dev`) ---
# Le seed VIDE et regénère la base. En release il refuse de tourner sans :
#SEED_ALLOW_DESTRUCTIVE=yes
# Dossier des PDF de consentement (défaut : /data dans l'image seed,
# scripts/seed avec `go run ./scripts/seed/` depuis backend/)
#SEED_PDF_DIR=
